# Database configuration
# For local dev, defaults to SQLite, but production will run PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_redistribution
# Example SQLite fallback configuration:
# DATABASE_URL=sqlite:///./food_redistribution.db

# JWT Authentication
JWT_SECRET_KEY=supersecretkeychangeinproduction12345!
JWT_REFRESH_SECRET_KEY=supersecretrefreshkeychangeinproduction67890!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload / Storage Configuration
# Options: local, s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# For S3 storage:
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=food-redistribution-uploads
AWS_REGION=us-east-1

# Email Notification Provider Configuration
# Options: console, smtp
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=no-reply@foodredistribution.org

# Map Provider Configuration
# If provided, maps will render. If blank, maps will degrade gracefully.
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Server Environment
ENV=development
HOST=0.0.0.0
PORT=8000
